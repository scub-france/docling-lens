# --- HTTP -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PDF conversion (docling-serve) ---------------------------------------
# Leave empty to disable the /api/documents endpoint (503).
DOCLING_SERVE_URL=http://localhost:5001
DOCLING_SERVE_API_KEY=
DOCLING_SERVE_TIMEOUT_S=600
MAX_PDF_SIZE_MB=25

# --- Reasoning ------------------------------------------------------------
# Off by default so the backend boots without docling-agent installed.
# When true, every per-agent flag below decides whether THAT agent is wired.
REASONING_ENABLED=false

# Per-agent feature flags — default ON (opt-out). Set to false to hide an
# agent from the top-bar toggle and 503 its endpoint, without touching the
# rest of the deployment. Adding a new agent: one more flag here.
FEATURE_RAG=true
FEATURE_ENRICH=true

# Only "ollama" is realizable today (docling-agent v0.1.0 is hardwired to it).
LLM_PROVIDER_TYPE=ollama
OLLAMA_HOST=http://localhost:11434
REASONING_MODEL_ID=mistral-small3.2

APP_VERSION=0.1.0
